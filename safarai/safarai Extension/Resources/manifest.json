{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0",

    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },

    "background": {
        "scripts": [ "background.js" ],
        "type": "module"
    },

    "content_scripts": [{
        "js": [ "content.js" ],
        "matches": [
            "*://github.com/*",
            "*://mail.google.com/*",
            "*://x.com/*",
            "*://twitter.com/*",
            "*://www.youtube.com/*",
            "*://m.youtube.com/*",
            "*://youtube.com/*",
            "*://www.bilibili.com/*",
            "*://m.bilibili.com/*",
            "*://bilibili.com/*",
            "*://mail.yahoo.com/*",
            "*://*.mail.yahoo.com/*",
            "<all_urls>"
        ]
    }],

    "host_permissions": [
        "*://*.youtube.com/*",
        "*://api.bilibili.com/*",
        "*://*.hdslb.com/*",
        "*://*.bilivideo.com/*"
    ],

    "action": {
        "default_icon": "images/toolbar-icon.svg"
    },

    "permissions": [
        "activeTab",
        "contextMenus",
        "nativeMessaging",
        "scripting",
        "storage",
        "tabs",
        "<all_urls>"
    ]
}
